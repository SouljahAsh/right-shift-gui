#!/bin/sh

branch="$(git branch --show-current 2>/dev/null)"
if [ -z "$branch" ]; then
  exit 0
fi

remote="$(git config --get "branch.$branch.remote" 2>/dev/null)"
if [ -z "$remote" ]; then
  remote="$(git remote | sed -n '1p')"
fi

if [ -z "$remote" ]; then
  exit 0
fi

merge_ref="$(git config --get "branch.$branch.merge" 2>/dev/null)"
if [ -n "$merge_ref" ]; then
  upstream_branch="${merge_ref#refs/heads/}"
else
  upstream_branch="$branch"
fi

git fetch "$remote" "$upstream_branch" || exit $?
if git rev-parse --verify --quiet "refs/remotes/$remote/$upstream_branch" >/dev/null; then
  git pull --rebase --autostash "$remote" "$upstream_branch" || exit $?
fi

if [ -f ./gradlew ]; then
  sh ./gradlew build -x installClientJar || exit $?
elif command -v cmd.exe >/dev/null 2>&1 && [ -f gradlew.bat ]; then
  cmd.exe //c gradlew.bat build -x installClientJar || exit $?
else
  exit 1
fi

git push "$remote" "HEAD:$upstream_branch"
